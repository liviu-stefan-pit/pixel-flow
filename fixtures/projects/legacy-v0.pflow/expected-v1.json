{
  "schemaVersion": 1,
  "name": "legacy-demo",
  "variables": {
    "label": "v0"
  },
  "defaults": {
    "timeoutMs": 5000,
    "retry": {
      "maxAttempts": 3,
      "backoffMs": 250
    }
  },
  "steps": [
    {
      "id": "a1",
      "type": "Wait",
      "waitMs": 50
    },
    {
      "id": "a2",
      "type": "Click",
      "timeoutMs": 2000,
      "locator": {
        "scope": {
          "processName": "Notepad",
          "windowTitle": "Untitled"
        },
        "layers": [
          {
            "kind": "UiaStructural",
            "enabled": true,
            "confidenceThreshold": 0.85,
            "automationId": "LegacyButton",
            "controlType": "Button",
            "name": "OK"
          }
        ]
      }
    }
  ]
}
