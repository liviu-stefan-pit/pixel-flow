<Window x:Class="PixelFlow.Studio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PixelFlow"
        Height="640"
        Width="920"
        MinHeight="480"
        MinWidth="720">
    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top"
                   Text="PixelFlow Studio"
                   FontSize="22"
                   FontWeight="SemiBold"
                   Margin="0,0,0,4" />

        <TextBlock DockPanel.Dock="Top"
                   TextWrapping="Wrap"
                   Opacity="0.85"
                   Margin="0,0,0,12"
                   Text="Default project: click-submit (needs Test Bench). Override with PIXELFLOW_PROJECT_FOLDER. Pause holds BETWEEN steps only. Emergency stop: Ctrl+Shift+F12 (global, Runner). Enable UIA Inspector and hover Test Bench to read AutomationId/Name/bounds." />

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="RunButton" Content="Run" Width="88" Margin="0,0,8,0" Click="OnRunClick" />
            <Button x:Name="PauseButton" Content="Pause" Width="88" Margin="0,0,8,0" Click="OnPauseClick" IsEnabled="False" />
            <Button x:Name="ResumeButton" Content="Resume" Width="88" Margin="0,0,8,0" Click="OnResumeClick" IsEnabled="False" />
            <Button x:Name="StopButton" Content="Stop" Width="88" Margin="0,0,16,0" Click="OnStopClick" IsEnabled="False" />
            <CheckBox x:Name="InspectorToggle"
                      Content="UIA Inspector"
                      VerticalAlignment="Center"
                      Checked="OnInspectorChecked"
                      Unchecked="OnInspectorUnchecked" />
        </StackPanel>

        <TextBlock x:Name="StatusText"
                   DockPanel.Dock="Top"
                   Text="Runner: Disconnected — click Run"
                   TextWrapping="Wrap"
                   Margin="0,0,0,4" />

        <TextBlock x:Name="ProjectPathText"
                   DockPanel.Dock="Top"
                   FontSize="11"
                   Opacity="0.75"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="280" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="320" MinWidth="240" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Text="Log" FontWeight="SemiBold" Margin="0,0,0,4" />
                <TextBox x:Name="LogBox"
                         IsReadOnly="True"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas"
                         FontSize="12"
                         AcceptsReturn="True"
                         TextWrapping="NoWrap" />
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" />

            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" Text="UIA Inspector" FontWeight="SemiBold" Margin="0,0,0,4" />
                <TextBlock DockPanel.Dock="Top"
                           TextWrapping="Wrap"
                           Opacity="0.75"
                           FontSize="11"
                           Margin="0,0,0,6"
                           Text="Check UIA Inspector, then hover any desktop element (e.g. Test Bench Submit). Properties update live — copy fields by hand into a locator." />
                <TextBox x:Name="InspectorBox"
                         IsReadOnly="True"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas"
                         FontSize="12"
                         AcceptsReturn="True"
                         TextWrapping="NoWrap"
                         Text="Inspector off — enable the checkbox above." />
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
