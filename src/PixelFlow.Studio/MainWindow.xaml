<Window x:Class="PixelFlow.Studio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PixelFlow"
        Height="520"
        Width="760"
        MinHeight="400"
        MinWidth="600">
    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top"
                   Text="PixelFlow Studio"
                   FontSize="22"
                   FontWeight="SemiBold"
                   Margin="0,0,0,4" />

        <TextBlock DockPanel.Dock="Top"
                   TextWrapping="Wrap"
                   Opacity="0.85"
                   Margin="0,0,0,12"
                   Text="Run plays three Wait steps (~12s), then finishes by itself — that is success. Pause holds BETWEEN steps (Resume/Stop). Test Bench is a separate app for later phases." />

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="RunButton" Content="Run" Width="88" Margin="0,0,8,0" Click="OnRunClick" />
            <Button x:Name="PauseButton" Content="Pause" Width="88" Margin="0,0,8,0" Click="OnPauseClick" IsEnabled="False" />
            <Button x:Name="ResumeButton" Content="Resume" Width="88" Margin="0,0,8,0" Click="OnResumeClick" IsEnabled="False" />
            <Button x:Name="StopButton" Content="Stop" Width="88" Click="OnStopClick" IsEnabled="False" />
        </StackPanel>

        <TextBlock x:Name="StatusText"
                   DockPanel.Dock="Top"
                   Text="Runner: Disconnected — click Run"
                   TextWrapping="Wrap"
                   Margin="0,0,0,4" />

        <TextBlock x:Name="ProjectPathText"
                   DockPanel.Dock="Top"
                   FontSize="11"
                   Opacity="0.75"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8" />

        <TextBlock DockPanel.Dock="Top" Text="Log" FontWeight="SemiBold" Margin="0,0,0,4" />

        <TextBox x:Name="LogBox"
                 IsReadOnly="True"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 FontFamily="Consolas"
                 FontSize="12"
                 AcceptsReturn="True"
                 TextWrapping="NoWrap" />
    </DockPanel>
</Window>
